@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <span class="brand">SmartDocs</span>
        <AuthorizeView>
            <Authorized>
                <span class="user">@context.User.Identity?.Name</span>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="/" />
                    <button type="submit" class="logout">Sair</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>

    <main>
        @Body
    </main>
</div>