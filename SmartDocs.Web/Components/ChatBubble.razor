@using SmartDocs.Web.Models
@using Markdig

<div class="bubble @(Message.Role == "user" ? "user" : "assistant")">
    @if (Message.Role == "assistant")
    {
        @if (string.IsNullOrEmpty(Message.Content))
        {
            <TypingIndicator />
        }
        else
        {
            @((MarkupString)RenderMarkdown(Message.Content))
        }
    }
    else
    {
        @Message.Content
    }
</div>

@code {
    [Parameter, EditorRequired] public Message Message { get; set; } = default!;

    // Desliguei o HTML em bruto (DisableHtml) de propósito — a resposta do
    // assistente vem de texto extraído de um PDF, que não é confiável. Sem isto,
    // se o modelo ecoasse HTML literal (de um PDF malicioso, ou de uma tentativa
    // de prompt injection), isso ia renderizar a sério por causa do MarkupString
    // aqui em baixo — um XSS. Desligar o HTML não estraga a formatação normal
    // (negrito, listas, blocos de código, etc.).
    private static readonly MarkdownPipeline Pipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private static string RenderMarkdown(string text) => Markdown.ToHtml(text ?? "", Pipeline);
}