@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.SignalR.Client
@using SmartDocs.Web.Models
@inject IJSRuntime JS
@inject IDocumentService DocumentService
@inject DocumentIngestionService Ingestion
@inject ConversationService Conversations
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>SmartDocs</PageTitle>

<div class="app">
    <AuthorizeView>
        <NotAuthorized>Por favor inicia sessão.</NotAuthorized>
    </AuthorizeView>

    <header class="hero">
        <h1>SmartDocs</h1>
        <p>Carrega um PDF e faz-lhe perguntas. As respostas são geradas por IA a partir do conteúdo do documento.</p>
    </header>

    <section class="card">
        <span class="step">1 · Carregar documento</span>
        <InputFile OnChange="HandleUpload" accept=".pdf" />
        @if (uploadStatus is not null) { <p class="status">@uploadStatus</p> }
    </section>

    <section class="card @(hasDocs ? "" : "locked")">
    <span class="step">2 · Conversar</span>

    <div class="chat" @ref="_chatContainer">
        @foreach (var m in _messages)
        {
            <ChatBubble Message="m" />
        }
    </div>

    <textarea @bind="question" rows="2" disabled="@(!hasDocs)"
              placeholder="Escreve a tua mensagem…"></textarea>
    <button @onclick="Ask" disabled="@(isAsking || !hasDocs)">
        @(isAsking ? "A escrever…" : "Enviar")
    </button>
</section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private HubConnection? _hub;
    private ElementReference _chatContainer;
    private string? currentDocId;
    private string _userId = "";
    private List<Message> _messages = new();
    private string question = "";
    private bool isAsking;
    private string? uploadStatus;
    private bool hasDocs;
    private const long MaxBytes = 20 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        _userId = (await AuthState!).User.FindFirst(ClaimTypes.NameIdentifier)!.Value;

        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/chat"))
            .WithAutomaticReconnect().Build();
        await _hub.StartAsync();
    }

    private async Task HandleUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        uploadStatus = "A processar…";
        try
        {
            if (file.ContentType != "application/pdf") { uploadStatus = "Só aceito PDF."; return; }
            if (file.Size > MaxBytes) { uploadStatus = "Ficheiro demasiado grande (máx. 20 MB)."; return; }

            await using var stream = file.OpenReadStream(MaxBytes);
            var doc = await DocumentService.SaveAsync(file.Name, stream);
            await Ingestion.IngestAsync(doc);

            currentDocId = doc.PublicId;
            hasDocs = true;
            uploadStatus = $"✓ {doc.FileName} indexado — já podes perguntar.";

            var convo = await Conversations.GetOrCreateAsync(_userId, currentDocId);
            _messages = convo.Messages.OrderBy(m => m.CreatedAt).ToList();   // conversa deste PDF
        }
        catch (Exception ex)
        {
            uploadStatus = $"Falhou: {ex.Message}";
        }
    }

    private async Task Ask()
    {
        if (_hub is null || string.IsNullOrWhiteSpace(question)) return;
        isAsking = true;

        var q = question;
        question = "";
        _messages.Add(new Message { Role = "user", Content = q });
        var reply = new Message { Role = "assistant", Content = "" };
        _messages.Add(reply);

        await foreach (var token in _hub.StreamAsync<string>("StreamAnswer", currentDocId, q, _userId))
        {
            reply.Content += token;
            await InvokeAsync(StateHasChanged);
        }
        isAsking = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}