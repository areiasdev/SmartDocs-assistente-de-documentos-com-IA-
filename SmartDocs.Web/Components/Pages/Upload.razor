@page "/upload"
@rendermode InteractiveServer
@inject IDocumentService DocumentService
@inject DocumentIngestionService Ingestion
@inject ILogger<Upload> Logger

<PageTitle>Carregar documento</PageTitle>
<h1>Carregar um PDF</h1>

<InputFile OnChange="HandleSelected" accept=".pdf" class="form-control" />

@if (isBusy)  { <p role="status">A processar…</p> }
@if (error is not null) { <p style="color:var(--bs-danger)">@error</p> }
@if (saved is not null) { <p style="color:green">Guardado: @saved.FileName (@saved.SizeBytes bytes)</p> }

@code {
    private bool isBusy;
    private string? error;
    private Document? saved;
    private const long MaxBytes = 20 * 1024 * 1024; // 20 MB

    private async Task HandleSelected(InputFileChangeEventArgs e)
    {
        error = null; saved = null; isBusy = true;
        try
        {
            var file = e.File;
            if (file.ContentType != "application/pdf") { error = "Só aceito PDF."; return; }
            if (file.Size > MaxBytes) { error = "Ficheiro demasiado grande."; return; }

            await using var stream = file.OpenReadStream(MaxBytes);
            saved = await DocumentService.SaveAsync(file.Name, stream);   // guardar

            try
            {
                await Ingestion.IngestAsync(saved);                       // indexar
            }
            catch (Exception ingestEx)   // separa a falha de indexação da de upload
            {
                error = $"Guardado, mas a indexação falhou: {ingestEx.Message}";
                Logger.LogError(ingestEx, "Falha na ingestão de {DocId}", saved.PublicId);
            }
        }
        catch (Exception ex)
        {
            error = $"Falha no upload: {ex.Message}";   // agora vês a causa REAL
            Logger.LogError(ex, "Falha no upload");
        }
        finally { isBusy = false; }
    }
}