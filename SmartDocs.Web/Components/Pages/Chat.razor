@page "/chat"
@rendermode InteractiveServer
@inject RagService Rag

<PageTitle>Perguntar</PageTitle>
<h1>Perguntar aos documentos</h1>

<textarea @bind="question" rows="3" class="form-control"
          placeholder="Escreve a tua pergunta…"></textarea>
<button class="btn btn-primary mt-2" @onclick="Ask" disabled="@isBusy">
    @(isBusy ? "A pensar…" : "Perguntar")
</button>

@if (error is not null) { <p style="color:var(--bs-danger)">@error</p> }

@if (answer is not null)
{
    <div class="mt-3">
        <h3>Resposta</h3>
        <p>@answer.Text</p>
        <details>
            <summary>Fontes (@answer.Sources.Count)</summary>
            @foreach (var s in answer.Sources)
            {
                <blockquote style="border-left:3px solid #ccc; padding-left:10px">@s.Text</blockquote>
            }
        </details>
    </div>
}

@code {
    private string question = "";
    private bool isBusy;
    private string? error;
    private RagAnswer? answer;

    private async Task Ask()
    {
        if (string.IsNullOrWhiteSpace(question)) return;
        isBusy = true; answer = null; error = null;
        try { answer = await Rag.AskAsync(question); }
        catch (Exception ex) { error = $"Falha ao perguntar: {ex.Message}"; }
        finally { isBusy = false; }
    }
}